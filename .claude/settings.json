{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build:*)",
      "Bash(npm run verify)",
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npx ng build:*)",
      "Bash(npx ng test:*)",
      "Bash(npx tsc -p:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)"
    ],
    "ask": [
      "Bash(npm run deploy:*)",
      "Bash(npm run rules:deploy:*)",
      "Bash(firebase deploy:*)",
      "Bash(npm publish:*)",
      "Bash(git push:*)"
    ]
  }
}
