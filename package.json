{
  "name": "fam-stack-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "fam-stack template: a Firebase + Angular + Material app you own, with its stack layer in projects/fam-stack.",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve starter",
    "build": "ng build starter",
    "build:dev": "ng build starter --configuration development",
    "build:lib": "ng build fam-stack",
    "watch": "ng build starter --watch --configuration development",
    "test": "ng test fam-stack --watch=false",
    "check:entries": "node scripts/check-entries.mjs",
    "lint": "eslint projects",
    "verify": "npm run check:entries && npm run lint && npm run build:lib && npm run build:dev && npm test",
    "emulators": "firebase emulators:start --project demo-fam-stack --only auth,firestore",
    "seed": "node scripts/seed-emulator.mjs",
    "smoke": "node scripts/smoke.mjs",
    "rules:test": "node --test scripts/firestore-rules.test.mjs",
    "rules:deploy": "firebase deploy --only firestore",
    "deploy": "npm run build && firebase deploy --only hosting"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/material": "^22.2.6",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "firebase": "^13.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.4",
    "@firebase/rules-unit-testing": "^6.0.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "ng-packagr": "^22.2.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "@firebase/util": false,
    "@parcel/watcher": false,
    "esbuild": false,
    "lmdb": false,
    "msgpackr-extract": false,
    "protobufjs": false
  }
}
